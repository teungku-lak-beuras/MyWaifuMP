CREATE TABLE MyWaifu (
    id INTEGER PRIMARY KEY NOT NULL,
    artistHref TEXT NOT NULL,
    artistName TEXT NOT NULL,
    sourceUrl TEXT NOT NULL,
    url TEXT NOT NULL UNIQUE
);

INSERT INTO MyWaifu (id, artistHref, artistName, sourceUrl, url) VALUES (
    1,
    "Hello world",
    "Hello world",
    "Hello world",
    "Hello world"
);

--- Get all waifus ---
getAllWaifus:
SELECT * FROM MyWaifu;

--- Insert a waifu ---
insertWaifu:
INSERT INTO MyWaifu (artistHref, artistName, sourceUrl, url) VALUES (
    ?, ?, ?, ?
);
